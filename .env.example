# ---------------------------------------------------------------------------
# Centro Sugbo Eagles Club Members Portal - environment template
# Copy to `.env.local` for development:  cp .env.example .env.local
# NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Neon PostgreSQL. Use the POOLED connection string for runtime (Vercel/serverless)
# and the DIRECT (un-pooled) string for migrations.
#   runtime  -> DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
#   migrate  -> DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Authentication ---------------------------------------------------------
# Generate with:  npx auth secret     (or)  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-32-byte-random-base64-string"
AUTH_URL="http://localhost:3000"
# Optional: trust host headers behind a proxy (Vercel sets this automatically).
AUTH_TRUST_HOST="true"
# Optional: force the `Secure` flag on the session/CSRF cookies.
# Leave unset to let the app decide: it turns the flag ON only when
# NEXT_PUBLIC_APP_URL (or AUTH_URL) is an https:// URL. That is what makes
# `npm run build && npm start` usable over http://localhost, where a Secure
# cookie would never be sent back and every sign-in would fail with MissingCSRF.
# AUTH_USE_SECURE_COOKIES="false"

# --- Application ------------------------------------------------------------
NODE_ENV="development"
# Absolute URL used in notification e-mails/links (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Security knobs ---------------------------------------------------------
# Failed logins before an account is temporarily locked.
LOGIN_MAX_FAILED_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"
# Session lifetime in hours (must match lib/auth.js maxAge).
SESSION_MAX_AGE_HOURS="8"
# Generic in-process rate limiter (requests / window per key).
RATE_LIMIT_MAX_REQUESTS="30"
RATE_LIMIT_WINDOW_SECONDS="60"

# --- File storage -----------------------------------------------------------
# "local" writes to ./public/uploads (development only, not persistent on Vercel).
# "disabled" rejects uploads. See lib/storage.js for adding a Vercel Blob / S3 driver.
STORAGE_DRIVER="local"
STORAGE_MAX_FILE_SIZE_MB="5"

# --- Seeding ----------------------------------------------------------------
# Seeds demo accounts ONLY when this is "true". Never enable in production.
SEED_DEMO_DATA="true"
SEED_DEFAULT_PASSWORD="ChangeMe!2024"